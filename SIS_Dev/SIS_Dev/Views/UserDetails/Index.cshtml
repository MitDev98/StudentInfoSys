
@model IEnumerable<SIS_Dev.Models.UserDetails>

@{
    ViewData["Title"] = "Index";
}

<h2>UserDetails List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<form asp-action="GeneratePdf" method="post">
    <button type="submit" class="btn btn-secondary">Generate PDF</button>
</form>
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.FirstName)</th>
                <th>@Html.DisplayNameFor(model => model.MiddleName)</th>
                <th>@Html.DisplayNameFor(model => model.LastName)</th>
                <th>@Html.DisplayNameFor(model => model.Email)</th>
                <th>@Html.DisplayNameFor(model => model.Date_of_birth)</th>
                <th>@Html.DisplayNameFor(model => model.ContactSelf)</th>
                <th>@Html.DisplayNameFor(model => model.ContactRef)</th>
                <th>@Html.DisplayNameFor(model => model.UID)</th>
                <th>@Html.DisplayNameFor(model => model.CurrentAddress)</th>
                <th>@Html.DisplayNameFor(model => model.CurrentPincode)</th>
                <th>@Html.DisplayNameFor(model => model.PermanentAddress)</th>
                <th>@Html.DisplayNameFor(model => model.PermanentPincode)</th>
                <th>Created Date</th>
                <th>Modified Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
                {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.FirstName)</td>
                    <td>@Html.DisplayFor(modelItem => item.MiddleName)</td>
                    <td>@Html.DisplayFor(modelItem => item.LastName)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Date_of_birth)</td>
                    <td>@Html.DisplayFor(modelItem => item.ContactSelf)</td>
                    <td>@Html.DisplayFor(modelItem => item.ContactRef)</td>
                    <td>@Html.DisplayFor(modelItem => item.UID)</td>
                    <td>@Html.DisplayFor(modelItem => item.CurrentAddress)</td>
                    <td>@Html.DisplayFor(modelItem => item.CurrentPincode)</td>
                    <td>@Html.DisplayFor(modelItem => item.PermanentAddress)</td>
                    <td>@Html.DisplayFor(modelItem => item.PermanentPincode)</td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CreatedBy)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.ModifiedBy)
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.UserdetailsID" class="btn btn-warning">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@item.UserdetailsID" class="btn btn-danger">Remove</a>|
                    </td>
                </tr>
                }
        </tbody>
    </table>
</div>

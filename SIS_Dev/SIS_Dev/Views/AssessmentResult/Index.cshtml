@model SIS_Dev.Models.AssessmentResultsViewModel

@{
    ViewData["Title"] = "Assessment Results List";
    var institutes = ViewBag.Institutes as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Head content omitted for brevity -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                alert(successMessage);
            }
        });
    </script>
</head>
<body>

    <h2>Assessment Results List</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <a asp-action="Index" asp-controller="Assessment" class="btn btn-info">Assessment Details</a>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Assessment</th>
                    <th>Student</th>
                    <th>Absent</th>
                    <th>Obtained Marks</th>
                    <th>Remark</th>
                    <th>Institute</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.AssessmentResults)
                    {
                    var student = Model.Students.FirstOrDefault(s => s.StudentID == item.StudentID);
                    <tr>
                        <td>@item.AssessmentID</td> <!-- Replace with actual assessment name if necessary -->
                        <td>
                            @if (student != null)
                                {
                                @($"{student.FirstName} {student.LastName}")
                                }
                            else
                                {
                                @("Not Available")
                                }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.Absent)</td>
                        <td>@Html.DisplayFor(modelItem => item.ObtainedMarks)</td>
                        <td>@Html.DisplayFor(modelItem => item.Remark)</td>
                        <td>@(institutes.ContainsKey(item.InstituteID) ? institutes[item.InstituteID] : "Institute Not Found")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.AssessmentResultID" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.AssessmentResultID" class="btn btn-danger btn-sm">Remove</a>
                        </td>
                    </tr>
                    }
            </tbody>
        </table>
    </div>

    <!-- JavaScript to handle popup display -->
    <script>
        setTimeout(function () {
            $('.alert').fadeOut('fast');
        }, 3000); // 3 seconds
    </script>
</body>
</html>

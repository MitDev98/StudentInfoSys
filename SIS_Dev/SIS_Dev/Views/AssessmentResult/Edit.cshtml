@model SIS_Dev.Models.AssessmentResult

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
    <style>
        body {
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        #form-container {
            width: 30%;
            background-color: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px gray;
            position: absolute;
            top: 45%;
            left: 57%;
            transform: translate(-50%, -50%);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        input[type="text"],
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .btn-warning {
            width: 100%;
            padding: 15px;
            background-color: gold;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

        .btn-primary:hover {
            background-color: #000;
        }

        .text-danger {
            color: red;
        }
    </style>
</head>
<body>
    <div id="form-container">

        <form method="post" asp-action="Edit" asp-controller="AssessmentResult">
        <h2 >
            EDIT ASSESSMENT RESULT
        </h2>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group form-check">
                <label asp-for="AssessmentResultID" class="form-label">AssessmentResultID</label>
                <input asp-for="AssessmentResultID" class="form-control" />
                <span asp-validation-for="AssessmentResultID" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AssessmentID" class="control-label"></label>
            <select asp-for="AssessmentID" class="form-control" asp-items="ViewBag.AssessmentID"></select>
            <span asp-validation-for="AssessmentID" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="StudentID" class="control-label"></label>
            <select asp-for="StudentID" class="form-control" asp-items="ViewBag.StudentID"></select>
            <span asp-validation-for="StudentID" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input asp-for="Absent" class="form-check-input" />
            <label asp-for="Absent" class="form-check-label">Absent</label>
            <span asp-validation-for="Absent" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ObtainedMarks">ObtainedMarks</label>
            <input asp-for="ObtainedMarks" class="form-control" />
            <span asp-validation-for="ObtainedMarks" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Remark">Remark</label>
            <input asp-for="Remark" class="form-control" />
            <span asp-validation-for="Remark" class="text-danger"></span>
        </div>
            <div class="form-group">
                <label asp-for="CreatedBy">CreatedBy</label>
                <input type="" asp-for="CreatedBy" class="form-control" readonly />
                <span asp-validation-for="CreatedBy" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="InstituteID" class="control-label"></label>
                <select asp-for="InstituteID" class="form-control" asp-items="ViewBag.InstituteID"></select>
                <span asp-validation-for="InstituteID" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Save</button>
    </form>
    </div>
</body>

</html>



@model IEnumerable<SIS_Dev.Models.Leave>

@{
    ViewData["Title"] = "Leave Request List";
    var faculties = ViewBag.Faculties as Dictionary<int, string>;
}

<h1>Leave Request List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">ADD LEAVE</a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-bordered" id="v">
        <thead class="thead-dark">
        <tr>

            <th>
                @Html.DisplayNameFor(model => model.StartDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EndDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reason)
            </th>
            <th>
              Faculty Name
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LeaveType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var leave in Model)
            {
            <tr>
                <td>@leave.StartDate.ToShortDateString()</td>
                <td>@leave.EndDate.ToShortDateString()</td>
                <td>@leave.Reason</td>
                <td>@faculties[leave.FacultyID]</td>
                <td>@leave.LeaveType</td>
                <td>@leave.Status</td>
                <td>
                        <a asp-action="Edit" asp-route-id="@leave.LeaveID" class="btn btn-warning btn-sm ">Edit</a> |
                        <a asp-action="Delete" asp-route-id="@leave.LeaveID" class="btn btn-danger btn-sm ">Delete</a>
                </td>
            </tr>
            }
    </tbody>
</table>
    @section Scripts {
        <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#v').DataTable();
            });
        </script>
    }
</div>
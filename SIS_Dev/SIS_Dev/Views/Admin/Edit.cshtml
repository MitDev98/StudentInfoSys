 *@
 @model SIS_Dev.Models.Admin

@{
    ViewBag.Title = "Edit Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <style>
        body {
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        #form-container {
            width: 30%;
            background-color: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px gray;
            position: absolute;
            top: 45%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        input[type="text"],
        input[type="password"],
        input[type="email"],
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .btn-primary {
            width: 100%;
            padding: 15px;
            background-color: blue;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .btn-primary:hover {
                background-color: #000;
            }

        .main {
            display: flex;
        }

        .inner {
            width: 600px;
            padding: 5px;
        }

        .text-danger {
            color: red;
        }
    </style>
</head>
<body>
    <div id="form-container">
        <form method="post" asp-action="Edit" asp-controller="Admin">
            <h2>Edit Admin</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.HiddenFor(model => model.AdminID)
            <div class="main">
                <div class="inner">
                    <div class="form-group">
                        <label asp-for="Email" class="control-label"></label>
                        <input asp-for="Email" class="form-control" type="email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Password" class="control-label"></label>
                        <input asp-for="Password" class="form-control" type="password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InstituteID" class="control-label"></label>
                        <select asp-for="InstituteID" class="form-control" asp-items="ViewBag.InstituteID"></select>
                        <span asp-validation-for="InstituteID" class="text-danger"></span>
                    </div>
                </div>
              
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
        <div style="margin-top: 10px;">
            @Html.ActionLink("Back to List", "Index", new { @class = "btn btn-primary" })
        </div>
    </div>
</body>
</html>

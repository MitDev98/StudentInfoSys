 @model IEnumerable<SIS_Dev.Models.Student>

@{
    ViewData["Title"] = "Student List";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="MarkAttendance" method="post">
    <input type="hidden" name="courseId" value="@ViewBag.CourseId" />
    <input type="hidden" name="standard" value="@ViewBag.Standard" />
    <input type="hidden" name="subject" value="@ViewBag.Subject" />

    <table class="table">
        <thead>
            <tr>
                <th>Student Name</th>
                <th>Absent</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
                {
                <tr>
                    <td>@student.FirstName @student.LastName</td>
                    <td><input type="checkbox" name="absentStudentIds" value="@student.StudentID" /></td>
                </tr>
                }
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary">Submit Attendance</button>
</form>


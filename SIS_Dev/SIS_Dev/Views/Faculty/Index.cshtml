
 @model IEnumerable<SIS_Dev.Models.Faculty>

@{
    ViewData["Title"] = "Faculty";
    var institutes = ViewBag.Institutes as Dictionary<int, string>;
    var courses = ViewBag.Courses as Dictionary<int, string>;
    var standards = ViewBag.Standards as Dictionary<int, string>;
    var subjects = ViewBag.Subjects as Dictionary<int, string>;
    var years = ViewBag.Years as List<string>;

}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Head content omitted for brevity -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                alert(successMessage);
            }
        });
    </script>

</head>
<body>
<h1>Faculty List</h1>

    <p>
        <!-- Create button and Filter form aligned horizontally -->
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
            <form method="get" asp-action="FilterFaculty" class="form-inline">
                <div class="form-group mr-2">
                    <label for="InstituteID" class="mr-2">Institute</label>
                    <select id="InstituteID" name="InstituteID" class="form-control">
                        <option value="">Select Institute</option>
                        @foreach (var institute in institutes)
                            {
                            <option value="@institute.Key">@institute.Value</option>
                            }
                    </select>
                </div>
                <div class="form-group mx-2">
                    <label for="Year" class="mr-2">Year</label>
                    <select id="Year" name="Year" class="form-control">
                        <option value="">Select Year</option>
                        @foreach (var year in years)
                            {
                            <option value="@year">@year</option>
                            }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </p>

<div class="table-responsive">

    <table class="table table-striped table-bordered" id="v">
        <thead class="thead-dark">
            <tr>
               
                <th>First Name</th>
                <th>Last Name</th>
                <th>Email</th>
                <th>Institute</th>
                <th>Course</th>
                <th>Standard</th>
                <th>Subject</th>
                <th>Year</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var faculty in Model)
                {
                <tr>
                 
                    <td>@faculty.FirstName</td>
                    <td>@faculty.LastName</td>
                    <td>@faculty.Email</td>
                    <td>@ViewBag.Institutes[faculty.InstituteID]</td>
                       
                        <td>
                            @if (courses != null && courses.ContainsKey(faculty.CourseID))
                                {
                                @courses[faculty.CourseID]
                                }
                            else
                                {
                                <span class="text-danger">Course not found</span>
                                }
                        </td>

                        <td>
                            @if (standards != null && standards.ContainsKey(faculty.StandardID))
                                {
                                @standards[faculty.StandardID]
                                }
                            else
                                {
                                <span class="text-danger">Standard not found</span>
                                }
                        </td>
                        <td>
                            @if (subjects != null && subjects.ContainsKey(faculty.SubjectID))
                                {
                                @subjects[faculty.SubjectID]
                                }
                            else
                                {
                                <span class="text-danger">Subject not found</span>
                                }
                        </td>
                        <td>@faculty.Year</td>

                    <td>
                        <a href="@Url.Action("Edit", "Faculty", new { id = faculty.FacultyID })" class="btn btn-sm btn-warning">Edit</a> |
                        <a href="@Url.Action("Delete", "Faculty", new { id = faculty.FacultyID })" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
                }
        </tbody>
    </table>
</div>
    <!-- JavaScript to handle popup display -->
    <script>
        setTimeout(function () {
            $('.alert').fadeOut('fast');
        }, 3000); // 3 seconds
    </script>
    @section Scripts {
        <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#v').DataTable();
            });
        </script>
    }

</body>
</html>

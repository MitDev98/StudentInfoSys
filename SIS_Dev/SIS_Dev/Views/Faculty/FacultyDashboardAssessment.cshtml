@model List<SIS_Dev.Models.Assessment>
<br/>
<h2>Assessments Assigned to You</h2>
<br/>
@if (Model.Count == 0)
    {
    <p>No assessments assigned to you.</p>
    }
else
    {
    <table class="table">
        <thead>
            <tr>
                <th>Course</th>
                <th>Standard</th>
                <th>Subject</th>
                <th>Date</th>
                <th>StartTime</th>
                <th>EndTime</th>
                <th>TotalMarks</th>
                <th>Action</th>
                <!-- Add more columns as needed -->
            </tr>
        </thead>
        <tbody>
            @foreach (var assessment in Model)
                {
                <tr>
                    <td>@GetCourseName(assessment.CourseID)</td>
                    <td>@assessment.StandardID</td>
                    <td>@assessment.SubjectName</td>
                    <td>@assessment.Date.ToShortDateString()</td>
                    <td>@assessment.StartTime.ToString(@"hh\:mm")</td>
                    <td>@assessment.EndTime.ToString(@"hh\:mm")</td>
                    <td>@assessment.TotalMarks</td>
                    <!-- Add more columns as needed -->
                    <td>
                        <a asp-action="StudentListAssessment" asp-route-assessmentId="@assessment.AssessmentID" class="btn btn-info">Take Assessment</a> |
                        <a asp-action="ViewAssessmentResults" asp-route-assessmentId="@assessment.AssessmentID" class="btn btn-warning">Show Result</a> |
                        <a asp-action="ViewAssessmentStatistics" asp-route-assessmentId="@assessment.AssessmentID" class="btn btn-success">View Statistics</a>
                    </td>
                </tr>
                }
        </tbody>
    </table>
    }

@functions {
    public string GetCourseName(int courseId)
        {
        // Fetch course name from ViewData["Courses"]
        var courses = ViewData["Courses"] as List<SIS_Dev.Models.Course>;
        var course = courses.FirstOrDefault(c => c.CourseID == courseId);
        return course != null ? course.Name : "Course Not Found";
        }
}

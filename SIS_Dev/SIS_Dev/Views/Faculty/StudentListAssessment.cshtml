                @model SIS_Dev.Models.StudentListViewModel

<h2>Students for Assessment</h2>

<form asp-action="SubmitAssessmentResults" method="post">
    <input type="hidden" asp-for="AssessmentId" />
    <table class="table">
        <thead>
            <tr>
                <th>Student ID</th>

                    obtainedMarksField.value = ''; // Clear the value
                    obtainedMarksField.disabled = false;
                    remarkField.value = ''; // Clear the value
                    remarkField.disabled = false;
                }
            });
        });

        document.querySelector('form').addEventListener('submit', function () {
            document.querySelectorAll('.absent-checkbox').forEach(function (checkbox) {

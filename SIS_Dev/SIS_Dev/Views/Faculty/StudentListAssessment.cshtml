@section Scripts {
    <script>
        document.querySelectorAll('.absent-checkbox').forEach(function (checkbox) {
            checkbox.addEventListener('change', function () {
                var index = this.getAttribute('data-index');
                var obtainedMarksField = document.querySelector('input[name="AssessmentResults[' + index + '].ObtainedMarks"]');
                var remarkField = document.querySelector('input[name="AssessmentResults[' + index + '].Remark"]');

                if (this.checked) {
                    obtainedMarksField.value = 0; // Default value to represent absence

@{
    ViewData["Title"] = "Home Page";
}

<div class="container">

    <div class="row">

        <div class="col-md-6 col-xl-6">
            <div class="card widget-card-1">
                <div class="card-block-small">
                    <i class="icofont icofont-ui-user bg-c-blue card1-icon"></i>
                    <h4> <span class="text-c-blue f-w-600">Total Students</span></h4> <br />
                    <h3 class="text-c-blue f-w-600">@ViewBag.TotalStudents</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-6">
            <div class="card widget-card-1">
                <div class="card-block-small">
                    <i class="icofont icofont-book bg-c-blue card1-icon"></i>
                    <h4> <span class="text-c-blue f-w-600">Total Assessments</span></h4><br />
                    <h3 class="text-c-blue f-w-600">@ViewBag.TotalAssessments</h3>
                </div>
            </div>
        </div>
    </div>
</div>

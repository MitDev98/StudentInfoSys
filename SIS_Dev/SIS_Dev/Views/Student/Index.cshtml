@model IEnumerable<SIS_Dev.Models.Student>

@{

    ViewData["Title"] = "Student List";
    var courses = ViewBag.Courses as Dictionary<int, string>;
    var institutes = ViewBag.Institutes as Dictionary<int, string>;
    var faculties = ViewBag.Faculties as Dictionary<int, string>;
    var standards = ViewBag.Standards as Dictionary<int, string>; // Added for standards
   // var institutes = (Dictionary<int, string>)ViewBag.Institutes;
    var years = ViewBag.Years as List<string>;

}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Head content omitted for brevity -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                alert(successMessage);
            }
        });
    </script>

</head>
<body>
<h2>Student List</h2>

    <p>
        <!-- Create button and Filter form aligned horizontally -->
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
            <form method="get" asp-action="FilterStudent" class="form-inline">
                <div class="form-group mr-2">
                    <label for="InstituteID" class="mr-2">Institute</label>
                    <select id="InstituteID" name="InstituteID" class="form-control">
                        <option value="">Select Institute</option>
                        @foreach (var institute in institutes)
                            {
                            <option value="@institute.Key">@institute.Value</option>
                            }
                    </select>
                </div>
                <div class="form-group mx-2">
                    <label for="Year" class="mr-2">Year</label>
                    <select id="Year" name="Year" class="form-control">
                        <option value="">Select Year</option>
                        @foreach (var year in years)
                            {
                            <option value="@year">@year</option>
                            }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </p>
<div class="table-responsive">
        <table class="table table-striped table-bordered" id="v">
        <thead class="thead-dark">
            <tr>
                <th>
                   FirstName
                </th>
                <th>
                    LastName
                </th>
                    <th>Institute</th>
                <th>
                    CourseName
                </th>
                <th>
                    Standard
                </th>
                    <th>Faculty</th>
                    <th>Year</th>

                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
                {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                        <td>@ViewBag.Institutes[item.InstituteID]</td>
                        
                        <td>
                            @if (courses != null && courses.ContainsKey(item.CourseID))
                                {
                                @courses[item.CourseID]
                                }
                            else
                                {
                                <span class="text-danger">Course not found</span>
                                }
                        </td>

                        <td>
                            @if (standards != null && standards.ContainsKey(item.StandardID))
                                {
                                @standards[item.StandardID]
                                }
                            else
                                {
                                <span class="text-danger">Standard not found</span>
                                }
                        </td>
                        <td>
                            @if (faculties != null && faculties.ContainsKey(item.FacultyID))
                                {
                                @faculties[item.FacultyID]
                                }
                            else
                                {
                                <span class="text-danger">Faculty not found</span>
                                }
                        </td>
                    
                        
                        <td>
                            @Html.DisplayFor(modelItem => item.Year)
                        </td>
                    <td>
                            <a asp-action="Edit" asp-route-id="@item.StudentID" asp-controller="Student" class="btn btn-warning btn-sm ">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@item.StudentID" asp-controller="Student" class="btn btn-danger btn-sm ">Remove</a>
                    </td>
                </tr>
                }
        </tbody>
    </table>
</div>
    <!-- JavaScript to handle popup display -->
    <script>
        setTimeout(function () {
            $('.alert').fadeOut('fast');
        }, 3000); // 3 seconds
    </script>
    @section Scripts {
        <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#v').DataTable();
            });
        </script>
    }
</body>
</html>

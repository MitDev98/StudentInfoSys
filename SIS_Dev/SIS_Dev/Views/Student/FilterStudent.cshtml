@model IEnumerable<SIS_Dev.Models.Student>

@{
    ViewBag.Title = "Filtered Student";
    var courses = ViewBag.Courses as Dictionary<int, string>;
    var institutes = ViewBag.Institutes as Dictionary<int, string>;
    var faculties = ViewBag.Faculties as Dictionary<int, string>;
    var standards = ViewBag.Standards as Dictionary<int, string>; // Added for standards                                                             
    var years = ViewBag.Years as List<string>;
}

<h2>Filtered Student</h2>

<p>
    <a asp-action="Index" class="btn btn-primary" style="border-radius: 10px">Back to List</a>
</p>


<div class="table-responsive">
    <table class="table table-striped table-bordered" id="v">
        <thead class="thead-dark">
            <tr>
                <th>
                    FirstName
                </th>
                <th>
                    LastName
                </th>
                <th>Institute</th>
                <th>
                    CourseName
                </th>
                <th>
                    Standard
                </th>
                <th>Faculty</th>
                <th>Year</th>

            
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
                {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.FirstName)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.LastName)
                    </td>
                    <td>@ViewBag.Institutes[item.InstituteID]</td>

                    <td>
                        @if (courses != null && courses.ContainsKey(item.CourseID))
                            {
                            @courses[item.CourseID]
                            }
                        else
                            {
                            <span class="text-danger">Course not found</span>
                            }
                    </td>

                    <td>
                        @if (standards != null && standards.ContainsKey(item.StandardID))
                            {
                            @standards[item.StandardID]
                            }
                        else
                            {
                            <span class="text-danger">Standard not found</span>
                            }
                    </td>
                    <td>
                        @if (faculties != null && faculties.ContainsKey(item.FacultyID))
                            {
                            @faculties[item.FacultyID]
                            }
                        else
                            {
                            <span class="text-danger">faculties not found</span>
                            }
                    </td>


                    <td>
                        @Html.DisplayFor(modelItem => item.Year)
                    </td>
                 
                </tr>
                }
        </tbody>
    </table>
</div>
<!-- JavaScript to handle popup display -->
<script>
    setTimeout(function () {
        $('.alert').fadeOut('fast');
    }, 3000); // 3 seconds
</script>
@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#v').DataTable();
        });
    </script>
}

@model SIS_Dev.Models.Assessment

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Assessment</title>
    <style>
        body {
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        #form-container {
            width: 50%;
            background-color: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px gray;
            position: absolute;
            top: 45%;
            left: 57%;
            transform: translate(-50%, -50%);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        input[type="text"],
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .btn-primary {
            width: 100%;
            padding: 15px;
            background-color: blue;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .btn-primary:hover {
                background-color: #000;
            }

        .main {
            display: flex;
        }

        .inner {
            width: 600px;
            padding: 15px;
        }

        .text-danger {
            color: red;
        }
    </style>
</head>
<body>
    <div id="form-container">
        <form method="post" asp-action="Create" asp-controller="Assessment">
            <h2>CREATE ASSESSMENT</h2>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="main">
                <div class="inner">
                    <div class="form-group">
                        <label asp-for="CourseID" class="control-label">Course</label>
                        <select asp-for="CourseID" id="CourseID" class="form-control" asp-items="ViewBag.CourseID"></select>
                        <span asp-validation-for="CourseID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>Date</label>
                        <input asp-for="Date" class="form-control" type="date" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TotalMarks">Total Marks</label>
                        <input asp-for="TotalMarks" class="form-control" />
                        <span asp-validation-for="TotalMarks" class="text-danger"></span>
                    </div>
                </div>
                <div class="inner">
                    <div class="form-group">
                        <label  class="control-label">Standard</label>
                        <select asp-for="StandardID" class="form-control" asp-items="ViewBag.StandardName"></select>
                        <span asp-validation-for="StandardID" class="text-danger"></span>
                    </div>

                    @* <div class="form-group">
                        <label for="StandardName">Standard</label>
                        <select id="StandardName" name="StandardName" class="form-control">
                            <option value="">Select Standard</option>
                            @foreach (var standard in ViewData["Standards"] as IEnumerable<SelectListItem>)
                                {
                                <option value="@standard.Value">@standard.Text</option>
                                }
                        </select>
                    </div> *@
                    <div class="form-group">
                        <label asp-for="StartTime">Start Time</label>
                        <input asp-for="StartTime" class="form-control" type="time" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PassingMarks">Passing Marks</label>
                        <input asp-for="PassingMarks" class="form-control" />
                        <span asp-validation-for="PassingMarks" class="text-danger"></span>
                    </div>
                </div>
                <div class="inner">
                    <div class="form-group">
                        <label asp-for="SubjectName" class="control-label">Subject</label>
                        <select  asp-for="SubjectName" class="form-control" asp-items="ViewBag.SubjectName"></select>
                        <span asp-validation-for="SubjectName" class="text-danger"></span>
                    </div>
@* 
                    <div class="form-group">
                        <label for="SubjectName">SubjectName</label>
                        <select id="SubjectName" name="SubjectName" class="form-control">
                            <option value="">Select Subject</option>
                            @foreach (var subject in ViewData["Subjects"] as IEnumerable<SelectListItem>)
                                {
                                <option value="@subject.Value">@subject.Text</option>
                                }
                        </select>
                    </div>
 *@
                    <div class="form-group">
                        <label asp-for="EndTime">End Time</label>
                        <input asp-for="EndTime" class="form-control" type="time" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>
                <div class="inner">
                    <div class="form-group">
                        <label asp-for="FacultyID" class="control-label">Faculty</label>
                        <select  asp-for="FacultyID" class="form-control" asp-items="ViewBag.FacultyID"></select>
                        <span asp-validation-for="FacultyID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="InstituteID" class="control-label"></label>
                        <select asp-for="InstituteID" class="form-control" asp-items="ViewBag.InstituteID"></select>
                        <span asp-validation-for="InstituteID" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <button type="submit" class="btn btn-primary">ADD</button>
        </form>
    </div>



    <script>
        $(document).ready(function () {
            $('#CourseID').change(function () {
                var courseId = $(this).val();
                $.ajax({
                    url: '@Url.Action("GetStandards", "Assessment")',
                    type: 'GET',
                    data: { courseId: courseId },
                    success: function (data) {
                        var options = '<option value="">Select Standard</option>';
                        for (var i = 0; i < data.length; i++) {
                            options += '<option value="' + data[i].StandardName + '">' + data[i].StandardName + '</option>';
                        }
                        $('#StandardName').html(options);
                        $('#SubjectName').html('<option value="">Select Subject</option>'); // Reset subjects
                    }
                });
            });

            $('#StandardName').change(function () {
                var courseId = $('#CourseID').val();
                var standardName = $(this).val();
                $.ajax({
                    url: '@Url.Action("GetSubjects", "Assessment")',
                    type: 'GET',
                    data: { courseId: courseId, standardName: standardName },
                    success: function (data) {
                        var options = '<option value="">Select Subject</option>';
                        for (var i = 0; i < data.length; i++) {
                            options += '<option value="' + data[i].SubjectName + '">' + data[i].SubjectName + '</option>';
                        }
                        $('#SubjectName').html(options);
                    }
                });
            });
        });
    </script>



</body>
</html> 


@model IEnumerable<SIS_Dev.Models.Assessment>

@{
    ViewData["Title"] = "Assessments List";
    var courses = ViewBag.Courses as Dictionary<int, string>;
    var faculties = ViewBag.Faculties as Dictionary<int, string>;
    var institutes = ViewBag.Institutes as Dictionary<int, string>;
}
<!DOCTYPE html>
<html lang="en">
<head>

    <!-- Head content omitted for brevity -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                alert(successMessage);
            }
        });
    </script>

</head>
<body>

<h2>Assessments List</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
    <a asp-action="Index" asp-controller="AssessmentResult" class="btn btn-info">Assessment Details</a>

</p>
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>

                <th style="width: 10%;">
                    @Html.DisplayNameFor(model => model.SubjectName)
                </th>
                <th style="width: 10%;">
                    @Html.DisplayNameFor(model => model.StartTime)
                </th>
                <th style="width: 10%;">
                    @Html.DisplayNameFor(model => model.EndTime)
                </th>
                <th style="width: 10%;">
                    Date
                </th>
                <th style="width: 10%;">
                    @Html.DisplayNameFor(model => model.TotalMarks)
                </th>
                 <th style="width: 10%;">
                    @Html.DisplayNameFor(model => model.PassingMarks)
                </th> 
                <th style="width: 10%;">
                        @Html.DisplayNameFor(model => model.StandardID)
                </th>
                <th style="width: 10%;">
                    CourseName
                </th>
                <th style="width: 10%;">
                    FacultyName
                </th>
                    <th style="width: 10%;">InstituteName</th>

              
                <th style="width: 15%;">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
                {
                <tr>

                    <td>
                        @Html.DisplayFor(modelItem => item.SubjectName)
                    </td>
                    <td>
                            @item.StartTime.ToString(@"hh\:mm")
                    </td>
                    <td>
                            @item.EndTime.ToString(@"hh\:mm")
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Date)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.TotalMarks)
                    </td>
                     <td>
                        @Html.DisplayFor(modelItem => item.PassingMarks)
                    </td> 
                    <td>
                            @Html.DisplayFor(modelItem => item.StandardID)
                    </td>
                    <td>@courses[item.CourseID]</td>
                    <td>@faculties[item.FacultyID]</td>
                        <td>@institutes[item.InstituteID]</td>

                    
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.AssessmentID" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.AssessmentID" class="btn btn-danger btn-sm">Remove</a>
                    </td>
                </tr>
                }
        </tbody>
    </table>
</div>
    <!-- JavaScript to handle popup display -->
    <script>
        setTimeout(function () {
            $('.alert').fadeOut('fast');
        }, 3000); // 3 seconds
    </script>
</body>
</html>
@model List<SIS_Dev.Models.TimetableViewModel>

@{
    ViewData["Title"] = "Timetables";
    var years = ViewData["Years"] as List<string>;

}

<h2>Timetables</h2>
<body>


    <form asp-action="Display" method="get">
        <div class="form-group">
            <label for="CourseID">Course</label>
            <select id="CourseID" name="courseId" class="form-control">
                <option value="">Select Course</option>
                @foreach (var course in ViewData["Courses"] as IEnumerable<SelectListItem>)
                    {
                    <option value="@course.Value">@course.Text</option>
                    }
            </select>
        </div>

        <div class="form-group">
            <label for="StandardID">Standard</label>
            <select id="StandardID" name="standardID" class="form-control">
                <option value="">Select Standard</option>
                @foreach (var standard in ViewData["Standards"] as IEnumerable<SelectListItem>)
                    {
                    <option value="@standard.Value">@standard.Text</option>
                    }
            </select>
        </div>

        <div class="form-group">
            <input type="submit" value="View Timetable" class="btn btn-info" />
        </div>
    </form>


<br />

<a asp-action="Create" class="btn btn-primary">ADD</a>
<br />
<br/>
<table class="table" id="v">
    <thead>
        <tr>
            <th>Course Name</th>
            <th>Faculty Name</th>
            <th>Subject Name</th>
            <th>Standard</th>
            <th>Days</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Institute</th>
                <th>Year</th>

            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
            {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.CourseName)</td>
                <td>@Html.DisplayFor(modelItem => item.FacultyName)</td>
                <td>@Html.DisplayFor(modelItem => item.SubjectName)</td>
                <td>@Html.DisplayFor(modelItem => item.StandardName)</td>
                <td>@Html.DisplayFor(modelItem => item.Days)</td>
                <td>@item.StartTime.ToString(@"hh\:mm")</td>
                <td>@item.EndTime.ToString(@"hh\:mm")</td>
                <td>@item.Name</td>
                    <td>@item.Year</td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.TimetableID" class="btn btn-warning btn-sm ">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.TimetableID" class="btn btn-danger btn-sm ">Delete</a>
                </td>
            </tr>
            }
    </tbody>
</table>



    <script type="text/javascript">
        $(document).ready(function () {
            $('#CourseID').change(function () {
                var courseId = $(this).val();
                if (courseId) {
                    $.getJSON('/Timetable/GetStandards', { courseId: courseId }, function (data) {
                        var standardSelect = $('#StandardID');
                        standardSelect.empty();
                        standardSelect.append($('<option>').text('Select Standard').attr('value', ''));
                        $.each(data, function (index, item) {
                            standardSelect.append($('<option>').text(item.text).attr('value', item.value));
                        });
                    });
                } else {
                    $('#StandardID').empty().append($('<option>').text('Select Standard').attr('value', ''));
                }
            });
        });
    </script>


@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#v').DataTable();
        });
    </script>
}
</body>

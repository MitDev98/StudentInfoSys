@model SIS_Dev.Models.Timetable

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EDIT TIMETABLE</title>
    <style>
        body {
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        #form-container {
            width: 50%;
            background-color: #fff;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 0 10px gray;
            position: absolute;
            top: 45%;
            left: 57%;
            transform: translate(-50%, -50%);
        }

        h2 {
            text-align: center;
            color: #333;
            margin-bottom: 20px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-weight: bold;
        }

        input[type="text"],
        select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }

        .btn-primary {
            width: 100%;
            padding: 15px;
            background-color: gold;
            color: #fff;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .btn-primary:hover {
                background-color: #000;
            }

        .main {
            display: flex;
        }

        .inner {
            width: 600px;
            padding: 15px;
        }

        .text-danger {
            color: red;
        }
    </style>
</head>
<body>
    <div id="form-container">
        <form method="post" asp-action="Edit" asp-controller="TimeTable">
            <h2>EDIT TIMETABLE</h2>

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="main">
                <div class="inner">
                    <div class="form-group">
                        <label asp-for="InstituteID" class="control-label">Institute</label>
                        <select asp-for="InstituteID" class="form-control" asp-items="ViewBag.Institutes"></select>
                        <span asp-validation-for="InstituteID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SubjectID" class="control-label">Subject</label>
                        <select asp-for="SubjectID" class="form-control" asp-items="ViewBag.Subjects"></select>
                        <span asp-validation-for="SubjectID" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="StartTime" class="control-label">Start Time</label>
                        <input asp-for="StartTime" class="form-control" type="time" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>


                </div>

                <div class="inner">
                    <div class="form-group">
                        <label asp-for="CourseID" class="control-label">Course</label>
                        <select asp-for="CourseID" class="form-control" asp-items="ViewBag.Courses"></select>
                        <span asp-validation-for="CourseID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FacultyID" class="control-label">Faculty</label>
                        <select asp-for="FacultyID" class="form-control" asp-items="ViewBag.Faculties"></select>
                        <span asp-validation-for="FacultyID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="EndTime" class="control-label">End Time</label>
                        <input asp-for="EndTime" class="form-control" type="time" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>


                </div>

                <div class="inner">
                    <div class="form-group">
                        <label asp-for="StandardID" class="control-label">Standard</label>
                        <select asp-for="StandardID" class="form-control" asp-items="ViewBag.Standards"></select>
                        <span asp-validation-for="StandardID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Days" class="control-label">Days</label>
                        <select asp-for="Days" class="form-control">
                            <option value="Monday">Monday</option>
                            <option value="Tuesday">Tuesday</option>
                            <option value="Wednesday">Wednesday</option>
                            <option value="Thursday">Thursday</option>
                            <option value="Friday">Friday</option>
                            <option value="Saturday">Saturday</option>
                        </select>
                        <span asp-validation-for="Days" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="TimetableID">SubjectID</label>
                        <input asp-for="TimetableID" class="form-control" readonly />
                        <span asp-validation-for="TimetableID" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Year">Year</label>
                        <select asp-for="Year" class="form-control" asp-items="ViewBag.Years"></select>
                        <span asp-validation-for="Year" class="text-danger"></span>
                    </div>

                </div>
            </div>
            <button type="submit" class="btn btn-primary">SAVE</button>
        </form>
    </div>

    <script>
        $(document).ready(function () {
            $('#InstituteID').change(function () {
                var instituteId = $(this).val();
                if (instituteId) {
                    $.ajax({
                        url: '@Url.Action("GetCourses", "Timetable")',
                        type: 'GET',
                        data: { instituteId: instituteId },
                        success: function (data) {
                            var options = '<option value="">Select Course</option>';
                            for (var i = 0; i < data.length; i++) {
                                options += '<option value="' + data[i].courseID + '">' + data[i].name + '</option>';
                            }
                            $('#CourseID').html(options);
                            $('#StandardID').html('<option value="">Select Standard</option>');
                            $('#SubjectID').html('<option value="">Select Subject</option>');
                            $('#FacultyID').html('<option value="">Select Faculty</option>');
                        }
                    });
                } else {
                    $('#CourseID').html('<option value="">Select Course</option>');
                    $('#StandardID').html('<option value="">Select Standard</option>');
                    $('#SubjectID').html('<option value="">Select Subject</option>');
                    $('#FacultyID').html('<option value="">Select Faculty</option>');
                }
            });

            $('#CourseID').change(function () {
                var courseId = $(this).val();
                if (courseId) {
                    $.ajax({
                        url: '@Url.Action("GetStand", "Timetable")',
                        type: 'GET',
                        data: { courseId: courseId },
                        success: function (data) {
                            var options = '<option value="">Select Standard</option>';
                            for (var i = 0; i < data.length; i++) {
                                options += '<option value="' + data[i].standardID + '">' + data[i].standardName + '</option>';
                            }
                            $('#StandardID').html(options);
                            $('#SubjectID').html('<option value="">Select Subject</option>');
                            $('#FacultyID').html('<option value="">Select Faculty</option>');
                        }
                    });
                } else {
                    $('#StandardID').html('<option value="">Select Standard</option>');
                    $('#SubjectID').html('<option value="">Select Subject</option>');
                    $('#FacultyID').html('<option value="">Select Faculty</option>');
                }
            });

            $('#StandardID').change(function () {
                var standardId = $(this).val();
                if (standardId) {
                    $.ajax({
                        url: '@Url.Action("GetSubjects", "Timetable")',
                        type: 'GET',
                        data: { standardId: standardId },
                        success: function (data) {
                            var options = '<option value="">Select Subject</option>';
                            for (var i = 0; i < data.length; i++) {
                                options += '<option value="' + data[i].subjectID + '">' + data[i].subjectName + '</option>';
                            }
                            $('#SubjectID').html(options);
                            $('#FacultyID').html('<option value="">Select Faculty</option>');
                        }
                    });
                } else {
                    $('#SubjectID').html('<option value="">Select Subject</option>');
                    $('#FacultyID').html('<option value="">Select Faculty</option>');
                }
            });

            $('#SubjectID').change(function () {
                var subjectId = $(this).val();
                if (subjectId) {
                    $.ajax({
                        url: '@Url.Action("GetFaculties", "Timetable")',
                        type: 'GET',
                        data: { subjectId: subjectId },
                        success: function (data) {
                            var options = '<option value="">Select Faculty</option>';
                            for (var i = 0; i < data.length; i++) {
                                options += '<option value="' + data[i].facultyID + '">' + data[i].firstName + '</option>';
                            }
                            $('#FacultyID').html(options);
                        }
                    });
                } else {
                    $('#FacultyID').html('<option value="">Select Faculty</option>');
                }
            });
        });
    </script>




</body>
</html>











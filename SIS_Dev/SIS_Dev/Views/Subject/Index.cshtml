@model IEnumerable<SIS_Dev.Models.Subject>

@{
    ViewData["Title"] = "Subject List";
    var courses = ViewBag.Courses as Dictionary<int, string>;
    var institutes = ViewBag.Institutes as Dictionary<int, string>;
    var standards = ViewBag.Standards as Dictionary<int, string>;
    var years = ViewBag.Years as List<string>;

}

<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Head content omitted for brevity -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            if (successMessage) {
                alert(successMessage);
            }
        });
    </script>
</head>
<body>
    <h2>Subject List</h2>

    <p>
        <!-- Create button and Filter form aligned horizontally -->
        <div class="d-flex justify-content-between align-items-center">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
            <form method="get" asp-action="FilterSubject" class="form-inline">
                <div class="form-group mr-2">
                    <label for="InstituteID" class="mr-2">Institute</label>
                    <select id="InstituteID" name="InstituteID" class="form-control">
                        <option value="">Select Institute</option>
                        @foreach (var institute in institutes)
                            {
                            <option value="@institute.Key">@institute.Value</option>
                            }
                    </select>
                </div>
                <div class="form-group mx-2">
                    <label for="Year" class="mr-2">Year</label>
                    <select id="Year" name="Year" class="form-control">
                        <option value="">Select Year</option>
                        @foreach (var year in years)
                            {
                            <option value="@year">@year</option>
                            }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary">Filter</button>
            </form>
        </div>
    </p>

    <div class="table-responsive">
        <table class="table table-striped table-bordered" id="v">
            <thead class="thead-dark">
                <tr>
                   
                    <th>SubjectName</th>
                    <th>Institute</th>
                    <th>Course Name</th>
                    <th>Standard</th>

                    <th>Subject Code</th>
                    <th>Year</th>

                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                    {
                    <tr>
                      
                        <td>@Html.DisplayFor(modelItem => item.SubjectName)</td>
                        <td>@ViewBag.Institutes[item.InstituteID]</td>

                        <td>
                            @if (courses != null && courses.ContainsKey(item.CourseID))
                                {
                                @courses[item.CourseID]
                                }
                            else
                                {
                                <span class="text-danger">Course not found</span>
                                }
                        </td>

                        <td>
                            @if (standards != null && standards.ContainsKey(item.StandardID))
                                {
                                @standards[item.StandardID]
                                }
                            else
                                {
                                <span class="text-danger">Standard not found</span>
                                }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.SubjectCode)</td>
                        <td>@item.Year</td>

                        <td>
                            <a asp-action="Edit" asp-route-id="@item.SubjectID" class="btn btn-primary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.SubjectID" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                    }
            </tbody>
        </table>
    </div>
    @section Scripts {
        <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
        <script>
            $(document).ready(function () {
                $('#v').DataTable();
            });
        </script>
    }
</body>
</html>

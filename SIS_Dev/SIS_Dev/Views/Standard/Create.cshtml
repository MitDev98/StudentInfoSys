@model SIS_Dev.Models.Standard<!DOCTYPE html><html lang="en"><head>    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>Create Standard</title>    <style>        body {            background-color: #f4f4f4;            margin: 0;            padding: 0;        }        #form-container {            width: 30%;            background-color: #fff;            padding: 30px;            border-radius: 8px;            box-shadow: 0 0 10px gray;            position: absolute;            top: 50%;            left: 50%;            transform: translate(-50%, -50%);        }        h2 {            text-align: center;            color: #333;            margin-bottom: 20px;        }        .form-group {            margin-bottom: 20px;        }        label {            font-weight: bold;        }        input[type="text"],        select {            width: 100%;            padding: 10px;            border: 1px solid #ccc;            border-radius: 4px;            box-sizing: border-box;        }        .btn-primary {            width: 100%;            padding: 15px;            background-color: blue;            color: #fff;            border: none;            border-radius: 4px;            cursor: pointer;            transition: background-color 0.3s;        }            .btn-primary:hover {                background-color: #000;            }        .text-danger {            color: red;        }    </style></head><body>    <div id="form-container">        <form method="post" asp-action="Create" asp-controller="Standard">            <h2>Add Standard</h2>            <div asp-validation-summary="ModelOnly" class="text-danger"></div>            <div class="form-group">                <label asp-for="InstituteID" class="control-label">Institute</label>                <select asp-for="InstituteID" class="form-control" asp-items="ViewBag.InstituteID"></select>                <span asp-validation-for="InstituteID" class="text-danger"></span>            </div>            <div class="form-group">                <label asp-for="CourseID" class="control-label">Courses</label>                <select asp-for="CourseID" class="form-control" asp-items="ViewBag.CourseID"></select>                <span asp-validation-for="CourseID" class="text-danger"></span>            </div>            <div class="form-group">                <label asp-for="StandardName" class="control-label">Standard Name</label>                <input asp-for="StandardName" class="form-control" />                <span asp-validation-for="StandardName" class="text-danger"></span>            </div>                       <div class="form-group">                <label asp-for="Year">Year</label>                <select asp-for="Year" class="form-control" asp-items="ViewBag.Years"></select>                <span asp-validation-for="Year" class="text-danger"></span>            </div>            <button type="submit" class="btn btn-primary">Add</button>        </form>    </div>    <script type="text/javascript">        $(document).ready(function () {            $('#InstituteID').change(function () {                var instituteId = $(this).val();                if (instituteId) {                    $.getJSON('/Faculty/GetCourses', { instituteId: instituteId }, function (data) {                        var courseSelect = $('#CourseID');                        courseSelect.empty();                        courseSelect.append($('<option>').text('Select Course').attr('value', ''));                        $.each(data, function (index, item) {                            courseSelect.append($('<option>').text(item.name).attr('value', item.courseID));                        });                    });                } else {                    $('#CourseID').empty().append($('<option>').text('Select Course').attr('value', ''));                                   }            });                        });    </script></body></html>